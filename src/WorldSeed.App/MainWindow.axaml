<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.MainWindow" Title="WorldSeed" Width="1360" Height="936" MinWidth="980" MinHeight="760" CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel><TextBlock Text="WorldSeed" FontSize="30"/><TextBlock Text="Traceable local rule drafting." Opacity="0.7"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Project:" VerticalAlignment="Center"/><ComboBox Name="ProjectSelector" Width="220" SelectionChanged="ProjectSelector_SelectionChanged"/><Button Content="New" Click="CreateProject_Click"/><Button Content="Open folder" Click="OpenProjectFolder_Click"/><Button Name="DeleteProjectButton" Content="Delete" Click="DeleteProject_Click"/></StackPanel></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="300,*,*" ColumnSpacing="16" Margin="0,24,0,16">
      <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Name="ProjectLocationText" Text="Projects are saved locally." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Source files" FontSize="20" Margin="0,12,0,0"/><Button Content="Add .txt notes" Click="AddNotes_Click"/><ListBox Name="SourceNotesList" Height="340" SelectionChanged="SourceNotesList_SelectionChanged"/><Button Content="Remove selected note" Click="RemoveSelectedNote_Click"/><TextBlock Text="Local model" Margin="0,12,0,0"/><Button Content="Refresh local models" Click="CheckLocalModels_Click"/><ComboBox Name="ModelSelector"/><Button Name="DraftButton" Content="Start selected source" Click="CreateSession_Click"/></StackPanel></ScrollViewer></Border>
      <Border Grid.Column="1" Padding="16"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Conversation" FontSize="20"/><TextBlock Name="SourceText" Text="Select a source file to inspect its original note." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Name="QuestionHeading" Text="" FontSize="16"/><StackPanel Name="QuestionsPanel" Spacing="8"/><Button Name="SubmitAnswersButton" Content="Submit answers and continue" Click="SubmitAnswers_Click" IsVisible="False"/></StackPanel></ScrollViewer></Border>
      <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,Auto,140,*" RowSpacing="10"><TextBlock Text="Project rules" FontSize="20"/><TextBlock Grid.Row="1" Name="StatusText" Text="Add notes, select a model, then start one source." TextWrapping="Wrap"/><ListBox Grid.Row="2" Name="RuleList" SelectionChanged="RuleList_SelectionChanged"/><TextBox Grid.Row="3" Name="DraftText" Text="Select a rule to review its wording and evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="Local-only: originals are preserved; drafts remain non-canonical." Opacity="0.6"/>
  </Grid>
</Window>
