<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.MainWindow" Title="WorldSeed" Width="1050" Height="720">
<Grid RowDefinitions="Auto,*,Auto" Margin="24"><StackPanel><TextBlock Text="WorldSeed" FontSize="30"/><TextBlock Text="Traceable local rule drafting." Opacity="0.7"/></StackPanel>
<Grid Grid.Row="1" ColumnDefinitions="330,*" ColumnSpacing="24" Margin="0,24,0,16"><Border Padding="16"><StackPanel Spacing="10"><TextBlock Text="1. Add notes"/><Button Content="Add .txt notes" Click="AddNotes_Click"/><ListBox Name="SourceNotesList" Height="150"/><Button Content="Remove selected note" Click="RemoveSelectedNote_Click"/><TextBlock Text="2. Local model"/><Button Content="Refresh local models" Click="CheckLocalModels_Click"/><ComboBox Name="ModelSelector"/><Button Name="DraftButton" Content="Create and advance session" Click="CreateSession_Click"/></StackPanel></Border>
<Border Grid.Column="1" Padding="20"><ScrollViewer><StackPanel Spacing="12"><TextBlock Text="Review" FontSize="22"/><TextBlock Name="StatusText" Text="Add notes, select a model, then draft." TextWrapping="Wrap"/><TextBlock Name="DraftText" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid>
<TextBlock Grid.Row="2" Text="Local-only: originals are preserved; drafts remain non-canonical." Opacity="0.6"/></Grid></Window>
