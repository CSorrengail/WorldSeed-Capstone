<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.MainWindow" Title="WorldSeed" Width="1360" Height="936" MinWidth="980" MinHeight="760" CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel><TextBlock Text="WorldSeed" FontSize="30"/><TextBlock Text="Traceable Local Rule Drafting." Opacity="0.7"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Project:" VerticalAlignment="Center"/><ComboBox Name="ProjectSelector" Width="220" SelectionChanged="ProjectSelector_SelectionChanged"/><Button Content="New" Click="CreateProject_Click"/><Button Content="Settings" Click="OpenSettings_Click"/><Button Content="Check Server" Click="CheckServer_Click"/><Button Name="DeleteProjectButton" Content="Delete" Click="DeleteProject_Click"/></StackPanel>
    </Grid>
    <TabControl Name="WorkspaceTabs" Grid.Row="1" Margin="0,24,0,16">
      <TabItem Header="Sources">
        <Grid ColumnDefinitions="300,*,*" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Name="ProjectLocationText" Text="Projects are saved in the local WorldSeed database." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Source Files" FontSize="20" Margin="0,12,0,0"/><Button Content="Add .TXT Notes" Click="AddNotes_Click"/><ListBox Name="SourceNotesList" Height="340" SelectionChanged="SourceNotesList_SelectionChanged"/><Button Content="Remove Selected Note" Click="RemoveSelectedNote_Click"/><TextBlock Text="Local Model" Margin="0,12,0,0"/><Button Content="Refresh Local Models" Click="CheckLocalModels_Click"/><ComboBox Name="ModelSelector"/><Button Name="DraftButton" Content="Start Selected Source" Click="CreateSession_Click"/></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Conversation" FontSize="20"/><TextBlock Name="SourceText" Text="Select a source file to inspect its original note." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Name="QuestionHeading" Text="" FontSize="16"/><StackPanel Name="QuestionsPanel" Spacing="8"/><Button Name="SubmitAnswersButton" Content="Submit Answers And Continue" Click="SubmitAnswers_Click" IsVisible="False"/></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,Auto,140,*" RowSpacing="10"><TextBlock Text="Source-Draft Rules" FontSize="20"/><TextBlock Grid.Row="1" Name="StatusText" Text="Add notes, select a model, then start one source." TextWrapping="Wrap"/><ListBox Grid.Row="2" Name="RuleList" SelectionChanged="RuleList_SelectionChanged"/><TextBox Grid.Row="3" Name="DraftText" Text="Select a rule to review its wording and evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Rules">
        <Grid ColumnDefinitions="330,*" ColumnSpacing="16">
          <Border Padding="16"><StackPanel Spacing="10"><TextBlock Text="Working Rule Set" FontSize="20"/><TextBlock Name="WorkingRulesSummaryText" Text="Create completed source drafts, then build a project-wide working proposal from small validated batches." TextWrapping="Wrap" Opacity="0.8"/><Button Name="BuildWorkingRulesButton" Content="Build Working Proposal" Click="BuildWorkingRules_Click"/><Button Content="Reload Saved Proposal" Click="ReloadWorkingRules_Click"/><TextBlock Text="This replaces the current working proposal only after traceability validation succeeds. Cross-source reconciliation is a later step." TextWrapping="Wrap" Opacity="0.6" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,170,*" RowSpacing="10"><TextBlock Name="WorkingRulesStatusText" Text="No project-level working proposal is loaded." TextWrapping="Wrap"/><ListBox Grid.Row="1" Name="WorkingRuleList" SelectionChanged="WorkingRuleList_SelectionChanged"/><TextBox Grid.Row="2" Name="WorkingRuleText" Text="Build or load a proposal to inspect its project-level rules and exact evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Schema">
        <Grid ColumnDefinitions="420,*" ColumnSpacing="16">
          <Border Padding="16"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10"><TextBlock Text="Schema Work Queue" FontSize="20"/><TextBlock Grid.Row="1" Text="Add any number of working rules. WorldSeed processes them one at a time, pausing when it needs a clarification or encounters an error." TextWrapping="Wrap" Opacity="0.8"/><Border Grid.Row="2" Padding="8" BorderThickness="1" CornerRadius="4" MaxHeight="210"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="SchemaQueuePanel" Spacing="6" HorizontalAlignment="Stretch"/></ScrollViewer></Border><StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><Button Name="BuildSchemaButton" Content="Process Queue" Click="BuildSchema_Click"/><Button Name="ClearSchemaQueueButton" Content="Clear Queue" Click="ClearSchemaQueue_Click"/></StackPanel><TextBlock Grid.Row="4" Name="SchemaQueueText" Text="No working rules are queued." TextWrapping="Wrap"/><ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="SchemaRuleGroupsPanel" Spacing="8" HorizontalAlignment="Stretch"/></ScrollViewer></Grid></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><TextBlock Name="SchemaStatusText" Text="Load a Working Rule Set, then select related rules to build a schema proposal." TextWrapping="Wrap"/><TextBox Grid.Row="1" Name="SchemaText" Text="No schema proposal is loaded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Grid.Row="2" Spacing="8"><Button Name="ActivateSchemaButton" Content="Activate Schema" Click="ActivateSchema_Click"/><Border Name="SchemaQuestionPanel" IsVisible="False" Padding="12" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="8"><TextBlock Text="Schema Clarification" FontSize="16"/><TextBlock Name="SchemaQuestionText" TextWrapping="Wrap"/><TextBox Name="SchemaAnswerText" PlaceholderText="Your Answer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Name="SubmitSchemaAnswerButton" Content="Submit Answer And Continue" Click="SubmitSchemaAnswer_Click"/></StackPanel></Border></StackPanel></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Game Data">
        <Grid RowDefinitions="*,Auto" RowSpacing="12">
          <Grid Name="GameDataReadyPanel" ColumnDefinitions="300,300,*" ColumnSpacing="16">
            <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Text="Active Schema" FontSize="20"/><TextBlock Name="ActiveSchemaText" Text="Activate a saved schema proposal to begin entering game data." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Text="Entity Types" FontSize="16" Margin="0,12,0,0"/><ListBox Name="GameDataEntityTypeList" Height="190" SelectionChanged="GameDataEntityTypeList_SelectionChanged"/><Button Name="AddGameDataEntityButton" Content="Add Selected Entity" Click="AddGameDataEntity_Click"/><TextBlock Text="Saved Entries" FontSize="16" Margin="0,12,0,0"/><ListBox Name="GameDataEntityList" Height="220" SelectionChanged="GameDataEntityList_SelectionChanged"/><Button Name="RemoveGameDataEntityButton" Content="Remove Selected Entry" Click="RemoveGameDataEntity_Click"/></StackPanel></ScrollViewer></Border>
            <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10"><TextBlock Text="Selected Entry" FontSize="20"/><TextBox Grid.Row="1" Name="GameDataEntityEditor" Text="Select an entry or add one from an entity type." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Grid.Row="2" Name="ApplyGameDataEntityButton" Content="Apply Entry Changes" Click="ApplyGameDataEntity_Click"/><Button Grid.Row="3" Name="ValidateAndSaveGameDataButton" Content="Validate And Save Game Data" Click="ValidateAndSaveGameData_Click"/></Grid></Border>
            <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><TextBlock Text="Full Game-Data Document" FontSize="20"/><TextBox Grid.Row="1" Name="GameDataJsonText" Text="Activate a schema to create a game-data document." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Grid.Row="2" Name="ApplyFullGameDataButton" Content="Apply Full Document Changes" Click="ApplyFullGameData_Click"/></Grid></Border>
          </Grid>
          <Border Name="GameDataEmptyStatePanel" IsVisible="False" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650">
            <StackPanel Spacing="14">
              <TextBlock Text="Game Data Needs An Entry Type" FontSize="24" TextWrapping="Wrap"/>
              <TextBlock Name="GameDataEmptyStateSchemaText" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Name="GameDataNoEntitiesText" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Text="Create Or Extend A Schema Proposal With A Concept That Has Individual Entries, Such As A Weapon, Skill, Location, Faction, Or Any Other Concept Your Game Uses. Then Activate The Updated Proposal." TextWrapping="Wrap" Opacity="0.7"/>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Open Schema Workspace" Click="OpenSchemaWorkspace_Click"/><Button Content="Refresh Game Data" Click="RefreshGameDataWorkspace_Click"/></StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Grid.Row="1" Name="GameDataStatusText" Text="No active schema is loaded." TextWrapping="Wrap"/>
        </Grid>
      </TabItem>
      <TabItem Header="Validation &amp; Balance (Later)" IsEnabled="False"/>
    </TabControl>
    <TextBlock Grid.Row="2" Text="Local-Only: Originals Are Preserved; Drafts Remain Non-Canonical." Opacity="0.6"/>
  </Grid>
</Window>
