<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.MainWindow" Title="WorldSeed" Width="1360" Height="936" MinWidth="980" MinHeight="760" CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel><TextBlock Text="WorldSeed" FontSize="30"/><TextBlock Text="Traceable Local Rule Drafting." Opacity="0.7"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Project:" VerticalAlignment="Center"/><ComboBox Name="ProjectSelector" Width="220" SelectionChanged="ProjectSelector_SelectionChanged"/><Button Content="New" Click="CreateProject_Click"/><Button Content="Settings" Click="OpenSettings_Click"/><Button Content="Check Server" Click="CheckServer_Click"/><Button Name="DeleteProjectButton" Content="Delete" Click="DeleteProject_Click"/></StackPanel>
    </Grid>
    <TabControl Name="WorkspaceTabs" Grid.Row="1" Margin="0,24,0,16">
      <TabItem Header="Sources">
        <Grid ColumnDefinitions="300,*,*" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Name="ProjectLocationText" Text="Projects are saved in the local WorldSeed database." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Source Files" FontSize="20" Margin="0,12,0,0"/><Button Content="Add .TXT Notes" Click="AddNotes_Click"/><ListBox Name="SourceNotesList" Height="340" SelectionChanged="SourceNotesList_SelectionChanged"/><Button Content="Remove Selected Note" Click="RemoveSelectedNote_Click"/><TextBlock Text="Local Model" Margin="0,12,0,0"/><Button Content="Refresh Local Models" Click="CheckLocalModels_Click"/><ComboBox Name="ModelSelector" SelectionChanged="ModelSelector_SelectionChanged"/><Button Name="DraftButton" Content="Start Selected Source" Click="CreateSession_Click"/></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Conversation" FontSize="20"/><TextBlock Name="SourceText" Text="Select a source file to inspect its original note." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Name="QuestionHeading" Text="" FontSize="16"/><StackPanel Name="QuestionsPanel" Spacing="8"/><Button Name="SubmitAnswersButton" Content="Submit Answers And Continue" Click="SubmitAnswers_Click" IsVisible="False"/></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,Auto,140,*" RowSpacing="10"><TextBlock Text="Source-Draft Rules" FontSize="20"/><TextBlock Grid.Row="1" Name="StatusText" Text="Add notes, select a model, then start one source." TextWrapping="Wrap"/><ListBox Grid.Row="2" Name="RuleList" SelectionChanged="RuleList_SelectionChanged"/><TextBox Grid.Row="3" Name="DraftText" Text="Select a rule to review its wording and evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Rules">
        <Grid ColumnDefinitions="330,*" ColumnSpacing="16">
          <Border Padding="16"><StackPanel Spacing="10"><TextBlock Text="Working Rule Set" FontSize="20"/><TextBlock Name="WorkingRulesSummaryText" Text="Create completed source drafts, then build a project-wide working proposal from small validated batches." TextWrapping="Wrap" Opacity="0.8"/><Button Name="BuildWorkingRulesButton" Content="Build Working Proposal" Click="BuildWorkingRules_Click"/><Button Content="Reload Saved Proposal" Click="ReloadWorkingRules_Click"/><TextBlock Text="This replaces the current working proposal only after traceability validation succeeds. Cross-source reconciliation is a later step." TextWrapping="Wrap" Opacity="0.6" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,170,*" RowSpacing="10"><TextBlock Name="WorkingRulesStatusText" Text="No project-level working proposal is loaded." TextWrapping="Wrap"/><ListBox Grid.Row="1" Name="WorkingRuleList" SelectionChanged="WorkingRuleList_SelectionChanged"/><TextBox Grid.Row="2" Name="WorkingRuleText" Text="Build or load a proposal to inspect its project-level rules and exact evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Schema">
        <Grid ColumnDefinitions="420,*" ColumnSpacing="16">
          <Border Padding="16"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10"><TextBlock Text="Schema Work Queue" FontSize="20"/><TextBlock Grid.Row="1" Text="Turn Working Rules Into Game Structures. A Content Type Is A Kind Of Thing With Individual Entries, Such As A Weapon, Skill, Location, Or Faction. Categories Describe Values Used By Those Entries." TextWrapping="Wrap" Opacity="0.8"/><Border Grid.Row="2" Padding="8" BorderThickness="1" CornerRadius="4" MaxHeight="210"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="SchemaQueuePanel" Spacing="6" HorizontalAlignment="Stretch"/></ScrollViewer></Border><StackPanel Grid.Row="3" Spacing="8"><Button Name="BuildGameStructuresButton" Content="Build Game Structures" Click="BuildGameStructures_Click"/><TextBlock Text="Automatically Finds Related Rules, Then Builds Small Content-Type And Relationship Proposals." TextWrapping="Wrap" Opacity="0.7"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="BuildSchemaButton" Content="Process Manual Queue" Click="BuildSchema_Click"/><Button Name="ClearSchemaQueueButton" Content="Clear Manual Queue" Click="ClearSchemaQueue_Click"/></StackPanel></StackPanel><TextBlock Grid.Row="4" Name="SchemaQueueText" Text="No working rules are queued." TextWrapping="Wrap"/><ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="SchemaRuleGroupsPanel" Spacing="8" HorizontalAlignment="Stretch"/></ScrollViewer></Grid></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><TextBlock Name="SchemaStatusText" Text="Load a Working Rule Set, then select related rules to build a schema proposal." TextWrapping="Wrap"/><TextBox Grid.Row="1" Name="SchemaText" Text="No schema proposal is loaded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Grid.Row="2" Spacing="8"><Button Name="ActivateSchemaButton" Content="Activate Schema" Click="ActivateSchema_Click"/><Expander Header="Add Rule To Current Schema" IsExpanded="False"><StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock Text="Use This For A Designer-Approved Rule Or System Change. WorldSeed Records The Request, Then Applies Only Its Focused Schema Change." TextWrapping="Wrap" Opacity="0.7"/><TextBox Name="SchemaChangeTitleText" PlaceholderText="Change Title (Example: Add Weapon Reach)"/><TextBox Name="SchemaChangeRuleText" PlaceholderText="Describe The Rule Or Schema Change To Add" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="ApplySchemaChangeButton" Content="Add Rule To Current Schema" Click="ApplySchemaChange_Click"/><Button Name="ClearSchemaChangeFieldsButton" Content="Clear Fields" Click="ClearSchemaChangeFields_Click"/></StackPanel><TextBlock Name="SchemaChangeRequestsText" Text="No Schema Changes Have Been Requested." TextWrapping="Wrap" Opacity="0.75"/><Button Name="ResumeSchemaChangeClarificationButton" Content="Resume Clarification" Click="ResumeSchemaChangeClarification_Click" IsVisible="False"/></StackPanel></Expander><Border Name="SchemaQuestionPanel" IsVisible="False" Padding="12" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="8"><TextBlock Text="Schema Clarification" FontSize="16"/><TextBlock Name="SchemaQuestionText" TextWrapping="Wrap"/><TextBox Name="SchemaAnswerText" PlaceholderText="Your Answer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Name="SubmitSchemaAnswerButton" Content="Submit Answer And Continue" Click="SubmitSchemaAnswer_Click"/></StackPanel></Border></StackPanel></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Game Data">
        <Grid RowDefinitions="*,Auto" RowSpacing="12">
          <Grid Name="GameDataReadyPanel" ColumnDefinitions="300,300,*" ColumnSpacing="16">
            <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Text="Active Schema" FontSize="20"/><TextBlock Name="ActiveSchemaText" Text="Activate a saved schema proposal to begin entering game data." TextWrapping="Wrap" Opacity="0.8"/><Button Name="ActivateSchemaFromReadyGameDataButton" Content="Activate Updated Proposal" Click="ActivateSchema_Click" IsVisible="False"/><TextBlock Text="Content Types" FontSize="16" Margin="0,12,0,0"/><ListBox Name="GameDataEntityTypeList" Height="190" SelectionChanged="GameDataEntityTypeList_SelectionChanged"/><Button Name="AddGameDataEntityButton" Content="Add Selected Entry" Click="AddGameDataEntity_Click"/><TextBlock Text="Saved Entries" FontSize="16" Margin="0,12,0,0"/><ListBox Name="GameDataEntityList" Height="220" SelectionChanged="GameDataEntityList_SelectionChanged"/><Button Name="RemoveGameDataEntityButton" Content="Remove Selected Entry" Click="RemoveGameDataEntity_Click"/></StackPanel></ScrollViewer></Border>
            <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10"><TextBlock Text="Selected Entry" FontSize="20"/><TextBox Grid.Row="1" Name="GameDataEntityEditor" Text="Select an entry or add one from an entity type." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Grid.Row="2" Name="ApplyGameDataEntityButton" Content="Apply Entry Changes" Click="ApplyGameDataEntity_Click"/><Button Grid.Row="3" Name="ValidateAndSaveGameDataButton" Content="Validate And Save Game Data" Click="ValidateAndSaveGameData_Click"/></Grid></Border>
            <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><TextBlock Text="Full Game-Data Document" FontSize="20"/><TextBox Grid.Row="1" Name="GameDataJsonText" Text="Activate a schema to create a game-data document." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Grid.Row="2" Name="ApplyFullGameDataButton" Content="Apply Full Document Changes" Click="ApplyFullGameData_Click"/></Grid></Border>
          </Grid>
          <Border Name="GameDataEmptyStatePanel" IsVisible="False" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650">
            <StackPanel Spacing="14">
              <TextBlock Text="Game Data Needs A Content Type" FontSize="24" TextWrapping="Wrap"/>
              <TextBlock Name="GameDataEmptyStateSchemaText" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Name="GameDataNoEntitiesText" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Text="Create Or Extend A Schema Proposal With A Concept That Has Individual Entries, Such As A Weapon, Skill, Location, Faction, Or Any Other Concept Your Game Uses. Then Activate The Updated Proposal." TextWrapping="Wrap" Opacity="0.7"/>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="ActivateSchemaFromEmptyGameDataButton" Content="Activate Updated Proposal" Click="ActivateSchema_Click" IsVisible="False"/><Button Content="Open Schema Workspace" Click="OpenSchemaWorkspace_Click"/><Button Content="Refresh Game Data" Click="RefreshGameDataWorkspace_Click"/></StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Grid.Row="1" Name="GameDataStatusText" Text="No active schema is loaded." TextWrapping="Wrap"/>
        </Grid>
      </TabItem>
      <TabItem Header="Content Review">
        <Grid ColumnDefinitions="300,*,320" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Text="Proposal Setup" FontSize="20"/><TextBlock Name="ContentReviewSchemaText" Text="Load an active schema and Working Rule Set before creating a proposal." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Text="Content Type"/><ComboBox Name="ContentProposalEntityTypeList" SelectionChanged="ContentProposalEntityTypeList_SelectionChanged"/><TextBlock Text="Designer Request"/><TextBox Name="ContentProposalRequestText" PlaceholderText="Describe The Content To Propose" TextChanged="ContentProposalRequestText_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Name="GenerateContentProposalButton" Content="Generate Proposal" Click="GenerateContentProposal_Click"/><Button Name="SuggestContentProposalButton" Content="Suggest New Content" Click="SuggestContentProposal_Click"/><Button Name="StartNewContentProposalButton" Content="Start New Proposal" Click="StartNewContentProposal_Click"/></WrapPanel><TextBlock Text="Suggestions Use A Bounded Set Of Current Canonical Entries And Recorded Designer Decisions. The Local Model Never Writes Directly To Canonical Game Data." TextWrapping="Wrap" Opacity="0.65"/><Expander Header="Game-Specific Balance Profile"><StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock Text="Profiles Are Optional, Advisory, And Tied To This Active Schema Revision. Use Only Your Game’s Rules And Reference Values." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Name="ContentBalanceProfileStatusText" Text="Select A Content Type To Inspect Its Balance Profile." TextWrapping="Wrap"/><TextBox Name="ContentBalanceProfileEditor" PlaceholderText="Balance Profile JSON" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Name="SaveContentBalanceProfileButton" Content="Save Balance Profile" Click="SaveContentBalanceProfile_Click"/></StackPanel></Expander></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10"><TextBlock Name="ContentProposalStatusText" Text="No Proposal Is Selected." TextWrapping="Wrap"/><Border Grid.Row="1" Padding="8" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="Schema Coverage And Generation Context" FontSize="16"/><TextBlock Name="ContentSchemaGapText" Text="Select A Proposal To Review Whether The Active Schema Covers Its Request." TextWrapping="Wrap"/><TextBlock Name="ContentGenerationContextText" Text="No Generation Context Is Selected." TextWrapping="Wrap" Opacity="0.75"/><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Name="OpenSchemaForContentGapButton" Content="Open Schema Workspace" Click="OpenSchemaWorkspace_Click" IsVisible="False"/><Button Name="ReevaluateContentProposalButton" Content="Re-Evaluate With Current Schema" Click="ReevaluateContentProposal_Click" IsVisible="False"/></WrapPanel></StackPanel></Border><TextBox Grid.Row="2" Name="ContentProposalEditor" Text="Generated Candidates Appear Here." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10"><Border Padding="10" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="Mechanical Validation" FontSize="16"/><TextBox Name="ContentMechanicalValidationText" Text="Select A Proposal To Validate It Against The Active Schema." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel></Border><Border Grid.Column="1" Padding="10" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="Balance Evaluation" FontSize="16"/><TextBox Name="ContentBalanceEvaluationText" Text="Select A Proposal To Evaluate Its Game-Specific Balance Profile." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel></Border></Grid><StackPanel Grid.Row="4" Spacing="8"><TextBlock Name="ContentDecisionGuidanceText" Text="Enter An Optional Decision Note. Revision Guidance Will Be Moved To Designer Request For Regeneration." TextWrapping="Wrap" Opacity="0.75"/><TextBox Name="ContentProposalDecisionNoteText" PlaceholderText="Revision Guidance Is Required; Approval And Rejection Notes Are Optional." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Name="SaveContentProposalRevisionButton" Content="Save Edited Proposal" Click="SaveContentProposalRevision_Click"/><Button Name="ApproveContentProposalButton" Content="Approve" Click="ApproveContentProposal_Click"/><Button Name="RejectContentProposalButton" Content="Reject" Click="RejectContentProposal_Click"/><Button Name="RequestContentProposalRevisionButton" Content="Request Revision" Click="RequestContentProposalRevision_Click"/><Button Name="ExportContentProposalButton" Content="Export Approved JSON" Click="ExportContentProposal_Click"/></WrapPanel></StackPanel></Grid></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="10"><TextBlock Text="Proposal History" FontSize="20"/><ListBox Grid.Row="1" Name="ContentProposalList" SelectionChanged="ContentProposalList_SelectionChanged"/><TextBlock Grid.Row="2" Text="Decisions" FontSize="16"/><TextBox Grid.Row="3" Name="ContentProposalDecisionHistoryText" Text="No decisions recorded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="Local-Only: Originals Are Preserved; Drafts Remain Non-Canonical." Opacity="0.6"/>
  </Grid>
</Window>
