<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.MainWindow" Title="WorldSeed" Width="1360" Height="780">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel><TextBlock Text="WorldSeed" FontSize="30"/><TextBlock Text="Traceable local rule drafting." Opacity="0.7"/></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="300,*,*" ColumnSpacing="16" Margin="0,24,0,16">
      <Border Padding="16"><StackPanel Spacing="10"><TextBlock Text="Source files" FontSize="20"/><Button Content="Add .txt notes" Click="AddNotes_Click"/><ListBox Name="SourceNotesList" Height="300" SelectionChanged="SourceNotesList_SelectionChanged"/><Button Content="Remove selected note" Click="RemoveSelectedNote_Click"/><TextBlock Text="Local model" Margin="0,12,0,0"/><Button Content="Refresh local models" Click="CheckLocalModels_Click"/><ComboBox Name="ModelSelector"/><Button Name="DraftButton" Content="Start selected source" Click="CreateSession_Click"/></StackPanel></Border>
      <Border Grid.Column="1" Padding="16"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Conversation" FontSize="20"/><TextBlock Name="SourceText" Text="Select a source file to inspect its original note." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Name="QuestionHeading" Text="" FontSize="16"/><StackPanel Name="QuestionsPanel" Spacing="8"/><Button Name="SubmitAnswersButton" Content="Submit answers and continue" Click="SubmitAnswers_Click" IsVisible="False"/></StackPanel></ScrollViewer></Border>
      <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="10"><TextBlock Text="Processed rules" FontSize="20"/><TextBlock Grid.Row="1" Name="StatusText" Text="Add notes, select a model, then start one source." TextWrapping="Wrap"/><TextBox Grid.Row="2" Name="DraftText" Text="A validated draft will appear here with its source excerpts." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="Local-only: originals are preserved; drafts remain non-canonical." Opacity="0.6"/>
  </Grid>
</Window>
