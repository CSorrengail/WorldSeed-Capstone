<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.MainWindow" Title="WorldSeed" Width="1360" Height="936" MinWidth="980" MinHeight="760" CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel><TextBlock Text="WorldSeed" FontSize="30"/><TextBlock Text="Traceable Local Rule Drafting." Opacity="0.7"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Project:" VerticalAlignment="Center"/><ComboBox Name="ProjectSelector" Width="220" SelectionChanged="ProjectSelector_SelectionChanged"/><Button Name="NewProjectButton" Content="New" Click="CreateProject_Click"/><Button Content="Settings" Click="OpenSettings_Click"/><Button Content="Check Server" Click="CheckServer_Click"/><Button Name="DeleteProjectButton" Content="Delete" Click="DeleteProject_Click"/></StackPanel>
    </Grid>
    <TabControl Name="WorkspaceTabs" Grid.Row="1" Margin="0,24,0,16">
      <TabItem Header="Sources">
        <Grid ColumnDefinitions="300,*,*" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Name="ProjectLocationText" Text="Projects are saved in the local WorldSeed database." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Source Files" FontSize="20" Margin="0,12,0,0"/><Button Content="Add .TXT Notes" Click="AddNotes_Click"/><Button Name="AddDesignIdeaButton" Content="Add Design Idea" Click="AddDesignIdea_Click"/><ListBox Name="SourceNotesList" Height="340" SelectionChanged="SourceNotesList_SelectionChanged"/><Button Content="Remove Selected Note" Click="RemoveSelectedNote_Click"/><TextBlock Text="Local Model" Margin="0,12,0,0"/><Button Content="Refresh Local Models" Click="CheckLocalModels_Click"/><ComboBox Name="ModelSelector" SelectionChanged="ModelSelector_SelectionChanged"/><Button Name="DraftButton" Content="Start Selected Source" Click="CreateSession_Click"/></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Conversation" FontSize="20"/><TextBlock Name="QuestionHeading" Text="" FontSize="16"/><StackPanel Name="QuestionsPanel" Spacing="8"/><Button Name="SubmitAnswersButton" Content="Submit Answers And Continue" Click="SubmitAnswers_Click" IsVisible="False"/><TextBlock Name="SourceText" Text="Select a source file to inspect its original note." TextWrapping="Wrap" Opacity="0.8"/></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,Auto,140,*" RowSpacing="10"><TextBlock Text="Source-Draft Rules" FontSize="20"/><TextBlock Grid.Row="1" Name="StatusText" Text="Add notes, select a model, then start one source." TextWrapping="Wrap"/><ListBox Grid.Row="2" Name="RuleList" SelectionChanged="RuleList_SelectionChanged"/><TextBox Grid.Row="3" Name="DraftText" Text="Select a rule to review its wording and evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Rules">
        <Grid ColumnDefinitions="330,*" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Working Rule Set" FontSize="20"/><TextBlock Name="WorkingRulesSummaryText" Text="Create Completed Source Drafts, Then Build A Project-Wide Working Proposal From Small Validated Batches." TextWrapping="Wrap" Opacity="0.8"/><Button Name="AddMissingWorkingRulesButton" Content="Add Missing Draft Rules" Click="AddMissingWorkingRules_Click"/><TextBlock Text="Adds Uncited Draft Rules While Preserving Existing Working Rules And IDs." TextWrapping="Wrap" Opacity="0.7"/><Button Name="BuildWorkingRulesButton" Content="Rebuild Working Proposal" Click="BuildWorkingRules_Click"/><Button Content="Reload Saved Proposal" Click="ReloadWorkingRules_Click"/><TextBlock Text="Rebuild Regenerates The Working Proposal From All Completed Drafts. Changes Are Saved After Traceability Validation." TextWrapping="Wrap" Opacity="0.6" Margin="0,12,0,0"/><Expander Header="Reconcile Rules" IsExpanded="True" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8">
              <TextBlock Text="Select One To Eight Rules. Supply Guidance To Resolve Conflicts Or Request A Revision." TextWrapping="Wrap"/>
              <TextBox Name="ReconciliationGuidanceText" PlaceholderText="Designer Guidance Or Clarification Answer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
              <Button Name="ProposeReconciliationButton" Content="Propose Rule Update" Click="ProposeReconciliation_Click"/>
              <ComboBox Name="ReconciliationHistoryList" SelectionChanged="ReconciliationHistory_SelectionChanged" HorizontalAlignment="Stretch"/>
              <TextBox Name="ReconciliationDetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
              <Button Name="ApplyReconciliationButton" Content="Accept And Apply Rules" Click="ApplyReconciliation_Click"/>
              <Button Name="RejectReconciliationButton" Content="Reject Rule Update" Click="RejectReconciliation_Click"/>
              <Button Name="PrepareReconciliationSchemaButton" Content="Prepare Schema Review" Click="PrepareReconciliationSchema_Click"/>
            </StackPanel></Expander></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,170,*" RowSpacing="10"><TextBlock Name="WorkingRulesStatusText" Text="No project-level working proposal is loaded." TextWrapping="Wrap"/><ListBox Grid.Row="1" Name="WorkingRuleList" SelectionMode="Multiple,Toggle" SelectionChanged="WorkingRuleList_SelectionChanged"/><TextBox Grid.Row="2" Name="WorkingRuleText" Text="Build or load a proposal to inspect its project-level rules and exact evidence." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Schema">
        <Grid ColumnDefinitions="420,*" ColumnSpacing="16">
          <Border Padding="16"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10"><TextBlock Text="Schema Work Queue" FontSize="20"/><TextBlock Grid.Row="1" Text="Turn Working Rules Into Game Structures. A Content Type Is A Kind Of Thing With Individual Entries, Such As A Weapon, Skill, Location, Or Faction. Categories Describe Values Used By Those Entries." TextWrapping="Wrap" Opacity="0.8"/><Border Grid.Row="2" Padding="8" BorderThickness="1" CornerRadius="4" MaxHeight="210"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="SchemaQueuePanel" Spacing="6" HorizontalAlignment="Stretch"/></ScrollViewer></Border><StackPanel Grid.Row="3" Spacing="8"><Button Name="BuildGameStructuresButton" Content="Build Game Structures" Click="BuildGameStructures_Click"/><TextBlock Text="Automatically Finds Related Rules Across The Whole Working Rule Set." TextWrapping="Wrap" Opacity="0.7"/><Button Name="BuildQueuedStructuresButton" Content="Build Structures From Queue" Click="BuildQueuedStructures_Click"/><TextBlock Text="Finds Related Structures Using Only The Working Rules You Added To The Queue." TextWrapping="Wrap" Opacity="0.7"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="BuildSchemaButton" Content="Process Individually" Click="BuildSchema_Click"/><Button Name="ClearSchemaQueueButton" Content="Clear Queue" Click="ClearSchemaQueue_Click"/></StackPanel></StackPanel><TextBlock Grid.Row="4" Name="SchemaQueueText" Text="No working rules are queued." TextWrapping="Wrap"/><ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="SchemaRuleGroupsPanel" Spacing="8" HorizontalAlignment="Stretch"/></ScrollViewer></Grid></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><TextBlock Name="SchemaStatusText" Text="Load a Working Rule Set, then select related rules to build a schema proposal." TextWrapping="Wrap"/><TextBox Grid.Row="1" Name="SchemaText" Text="No schema proposal is loaded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Grid.Row="2" Spacing="8"><Button Name="ActivateSchemaButton" Content="Activate Schema" Click="ActivateSchema_Click"/><Expander Header="Add Rule To Current Schema" IsExpanded="False"><StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock Text="Use This For A Designer-Approved Rule Or System Change. WorldSeed Records The Request, Then Applies Only Its Focused Schema Change." TextWrapping="Wrap" Opacity="0.7"/><TextBox Name="SchemaChangeTitleText" PlaceholderText="Change Title (Example: Add Weapon Reach)"/><TextBox Name="SchemaChangeRuleText" PlaceholderText="Describe The Rule Or Schema Change To Add" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="ApplySchemaChangeButton" Content="Add Rule To Current Schema" Click="ApplySchemaChange_Click"/><Button Name="ClearSchemaChangeFieldsButton" Content="Clear Fields" Click="ClearSchemaChangeFields_Click"/></StackPanel><TextBlock Name="SchemaChangeRequestsText" Text="No Schema Changes Have Been Requested." TextWrapping="Wrap" Opacity="0.75"/><Button Name="ResumeSchemaChangeClarificationButton" Content="Resume Clarification" Click="ResumeSchemaChangeClarification_Click" IsVisible="False"/></StackPanel></Expander><Border Name="SchemaQuestionPanel" IsVisible="False" Padding="12" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="8"><TextBlock Text="Schema Clarification" FontSize="16"/><TextBlock Name="SchemaQuestionText" TextWrapping="Wrap"/><TextBox Name="SchemaAnswerText" PlaceholderText="Your Answer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Name="SubmitSchemaAnswerButton" Content="Submit Answer And Continue" Click="SubmitSchemaAnswer_Click"/></StackPanel></Border></StackPanel></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Game Data">
        <Grid RowDefinitions="*,Auto" RowSpacing="12">
          <Grid Name="GameDataReadyPanel" ColumnDefinitions="300,300,*" ColumnSpacing="16">
            <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Text="Active Schema" FontSize="20"/><TextBlock Name="ActiveSchemaText" Text="Activate a saved schema proposal to begin entering game data." TextWrapping="Wrap" Opacity="0.8"/><Button Name="ActivateSchemaFromReadyGameDataButton" Content="Activate Updated Proposal" Click="ActivateSchema_Click" IsVisible="False"/><TextBlock Text="Content Types" FontSize="16" Margin="0,12,0,0"/><ListBox Name="GameDataEntityTypeList" Height="190" SelectionChanged="GameDataEntityTypeList_SelectionChanged"/><Button Name="AddGameDataEntityButton" Content="Add Selected Entry" Click="AddGameDataEntity_Click"/><TextBlock Text="Saved Entries" FontSize="16" Margin="0,12,0,0"/><ListBox Name="GameDataEntityList" Height="220" SelectionChanged="GameDataEntityList_SelectionChanged"/><Button Name="RemoveGameDataEntityButton" Content="Remove Selected Entry" Click="RemoveGameDataEntity_Click"/></StackPanel></ScrollViewer></Border>
            <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10"><TextBlock Text="Selected Entry" FontSize="20"/><TextBox Grid.Row="1" Name="GameDataEntityEditor" Text="Select an entry or add one from an entity type." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Grid.Row="2" Name="ApplyGameDataEntityButton" Content="Apply Entry Changes" Click="ApplyGameDataEntity_Click"/><Button Grid.Row="3" Name="ValidateAndSaveGameDataButton" Content="Validate And Save Game Data" Click="ValidateAndSaveGameData_Click"/></Grid></Border>
            <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"><TextBlock Text="Full Game-Data Document" FontSize="20"/><TextBox Grid.Row="1" Name="GameDataJsonText" Text="Activate a schema to create a game-data document." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Grid.Row="2" Name="ApplyFullGameDataButton" Content="Apply Full Document Changes" Click="ApplyFullGameData_Click"/></Grid></Border>
          </Grid>
          <Border Name="GameDataEmptyStatePanel" IsVisible="False" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650">
            <StackPanel Spacing="14">
              <TextBlock Text="Game Data Needs A Content Type" FontSize="24" TextWrapping="Wrap"/>
              <TextBlock Name="GameDataEmptyStateSchemaText" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Name="GameDataNoEntitiesText" TextWrapping="Wrap" Opacity="0.8"/>
              <TextBlock Text="Create Or Extend A Schema Proposal With A Concept That Has Individual Entries, Such As A Weapon, Skill, Location, Faction, Or Any Other Concept Your Game Uses. Then Activate The Updated Proposal." TextWrapping="Wrap" Opacity="0.7"/>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="ActivateSchemaFromEmptyGameDataButton" Content="Activate Updated Proposal" Click="ActivateSchema_Click" IsVisible="False"/><Button Content="Open Schema Workspace" Click="OpenSchemaWorkspace_Click"/><Button Content="Refresh Game Data" Click="RefreshGameDataWorkspace_Click"/></StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Grid.Row="1" Name="GameDataStatusText" Text="No active schema is loaded." TextWrapping="Wrap"/>
        </Grid>
      </TabItem>
      <TabItem Header="Content Review">
        <Grid ColumnDefinitions="300,*,320" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10"><TextBlock Text="Proposal Setup" FontSize="20"/><TextBlock Name="ContentReviewSchemaText" Text="Load an active schema and Working Rule Set before creating a proposal." TextWrapping="Wrap" Opacity="0.8"/><TextBlock Text="Content Type"/><ComboBox Name="ContentProposalEntityTypeList" SelectionChanged="ContentProposalEntityTypeList_SelectionChanged"/><TextBlock Text="Designer Request"/><TextBox Name="ContentProposalRequestText" PlaceholderText="Describe The Content To Propose" TextChanged="ContentProposalRequestText_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Name="GenerateContentProposalButton" Content="Generate Proposal" Click="GenerateContentProposal_Click"/><Button Name="SuggestContentProposalButton" Content="Suggest New Content" Click="SuggestContentProposal_Click"/><Button Name="StartNewContentProposalButton" Content="Start New Proposal" Click="StartNewContentProposal_Click"/></WrapPanel><TextBlock Text="Suggestions Use A Bounded Set Of Current Canonical Entries And Recorded Designer Decisions. The Local Model Never Writes Directly To Canonical Game Data." TextWrapping="Wrap" Opacity="0.65"/><Expander Header="Sequential Expansion Queue"><StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock Text="Generate A Small Set One At A Time. Every Result Remains A Separate Proposal With Its Own Validation, Balance, Decisions, And Application." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Requested Entries"/><ComboBox Name="ContentExpansionCountList" SelectedIndex="1"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox><WrapPanel ItemSpacing="8" LineSpacing="8"><Button Name="StartContentExpansionButton" Content="Start Expansion Queue" Click="StartContentExpansion_Click"/><Button Name="StopContentExpansionButton" Content="Stop After Current" Click="StopContentExpansion_Click" IsEnabled="False"/></WrapPanel><TextBlock Name="ContentExpansionStatusText" Text="No Expansion Queue Is Running." TextWrapping="Wrap"/><ListBox Name="ContentExpansionQueueList" MinHeight="90" MaxHeight="160"/></StackPanel></Expander><Expander Header="Game-Specific Balance Profile"><StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock Text="Profiles Are Optional, Advisory, And Tied To This Active Schema Revision. Use Only Your Game’s Rules And Reference Values." TextWrapping="Wrap" Opacity="0.7"/><TextBlock Name="ContentBalanceProfileStatusText" Text="Select A Content Type To Inspect Its Balance Profile." TextWrapping="Wrap"/><TextBox Name="ContentBalanceProfileEditor" PlaceholderText="Balance Profile JSON" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Name="SaveContentBalanceProfileButton" Content="Save Balance Profile" Click="SaveContentBalanceProfile_Click"/></StackPanel></Expander></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10"><TextBlock Name="ContentProposalStatusText" Text="No Proposal Is Selected." TextWrapping="Wrap"/><Border Grid.Row="1" Padding="8" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="Schema Coverage And Generation Context" FontSize="16"/><TextBlock Name="ContentSchemaGapText" Text="Select A Proposal To Review Whether The Active Schema Covers Its Request." TextWrapping="Wrap"/><TextBlock Name="ContentGenerationContextText" Text="No Generation Context Is Selected." TextWrapping="Wrap" Opacity="0.75"/><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Name="OpenSchemaForContentGapButton" Content="Open Schema Workspace" Click="OpenSchemaWorkspace_Click" IsVisible="False"/><Button Name="ReevaluateContentProposalButton" Content="Re-Evaluate With Current Schema" Click="ReevaluateContentProposal_Click" IsVisible="False"/></WrapPanel></StackPanel></Border><TextBox Grid.Row="2" Name="ContentProposalEditor" Text="Generated Candidates Appear Here." AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10"><Border Padding="10" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="Mechanical Validation" FontSize="16"/><TextBox Name="ContentMechanicalValidationText" Text="Select A Proposal To Validate It Against The Active Schema." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel></Border><Border Grid.Column="1" Padding="10" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="6"><TextBlock Text="Balance Evaluation" FontSize="16"/><TextBox Name="ContentBalanceEvaluationText" Text="Select A Proposal To Evaluate Its Game-Specific Balance Profile." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel></Border></Grid><StackPanel Grid.Row="4" Spacing="8"><TextBlock Name="ContentDecisionGuidanceText" Text="Enter An Optional Decision Note. Revision Guidance Will Be Moved To Designer Request For Regeneration." TextWrapping="Wrap" Opacity="0.75"/><TextBox Name="ContentProposalDecisionNoteText" PlaceholderText="Revision Guidance Is Required; Approval And Rejection Notes Are Optional." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Name="SaveContentProposalRevisionButton" Content="Save Edited Proposal" Click="SaveContentProposalRevision_Click"/><Button Name="ApproveContentProposalButton" Content="Approve" Click="ApproveContentProposal_Click"/><Button Name="ApplyApprovedContentButton" Content="Apply Approved To Game Data" Click="ApplyApprovedContent_Click"/><Button Name="RejectContentProposalButton" Content="Reject" Click="RejectContentProposal_Click"/><Button Name="RequestContentProposalRevisionButton" Content="Request Revision" Click="RequestContentProposalRevision_Click"/><Button Name="ExportContentProposalButton" Content="Export Approved JSON" Click="ExportContentProposal_Click"/></WrapPanel></StackPanel></Grid></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="10"><TextBlock Text="Proposal History" FontSize="20"/><ListBox Grid.Row="1" Name="ContentProposalList" SelectionChanged="ContentProposalList_SelectionChanged"/><TextBlock Grid.Row="2" Text="Decisions" FontSize="16"/><TextBox Grid.Row="3" Name="ContentProposalDecisionHistoryText" Text="No decisions recorded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Evaluation Assistance">
        <Grid ColumnDefinitions="320,320,*" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
            <TextBlock Text="Evaluation Proposal Setup" FontSize="20"/>
            <TextBlock Text="Ask The Local Model To Suggest Game-Specific Mechanical Validation Or Advisory Balance Coverage. Suggestions Never Apply Themselves." TextWrapping="Wrap" Opacity="0.75"/>
            <TextBlock Text="Content Type"/>
            <ComboBox Name="EvaluationEntityTypeList"/>
            <TextBlock Text="Evaluation Category"/>
            <ComboBox Name="EvaluationKindList" SelectedIndex="0"><ComboBoxItem Content="Mechanical Validation"/><ComboBoxItem Content="Advisory Balance Profile"/></ComboBox>
            <TextBlock Text="Designer Goal"/>
            <TextBox Name="EvaluationGoalText" PlaceholderText="Describe The Coverage To Propose" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Button Name="GenerateEvaluationProposalButton" Content="Generate Evaluation Proposal" Click="GenerateEvaluationProposal_Click" IsEnabled="False"/>
            <TextBlock Name="EvaluationAssistanceStatusText" Text="Load A Project With An Active Schema And Working Rules." TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <TextBlock Text="Proposal History" FontSize="20"/>
            <ListBox Grid.Row="1" Name="EvaluationProposalList" SelectionChanged="EvaluationProposalList_SelectionChanged"/>
            <Button Grid.Row="2" Content="Refresh Proposals" Click="RefreshEvaluationProposals_Click"/>
          </Grid></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Name="EvaluationProposalHeadingText" Text="Select An Evaluation Proposal." FontSize="20" TextWrapping="Wrap"/>
            <TextBox Grid.Row="1" Name="EvaluationProposalDetailText" Text="Generated Candidate Details Appear Here." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBox Grid.Row="2" Name="EvaluationDecisionNoteText" PlaceholderText="Revision Guidance Is Required; Other Decision Notes Are Optional" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <WrapPanel Grid.Row="3" ItemSpacing="8" LineSpacing="8"><Button Name="ApproveEvaluationProposalButton" Content="Approve" Click="ApproveEvaluationProposal_Click" IsEnabled="False"/><Button Name="RejectEvaluationProposalButton" Content="Reject" Click="RejectEvaluationProposal_Click" IsEnabled="False"/><Button Name="ReviseEvaluationProposalButton" Content="Request Revision" Click="ReviseEvaluationProposal_Click" IsEnabled="False"/></WrapPanel>
            <Button Grid.Row="4" Name="UseApprovedEvaluationProposalButton" Content="Use Approved Proposal" Click="UseApprovedEvaluationProposal_Click" IsEnabled="False"/>
          </Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Content Expansion">
        <Grid ColumnDefinitions="360,*" ColumnSpacing="16">
          <Border Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <TextBlock Text="Multi-Type Expansion Plan" FontSize="20"/>
                <TextBlock Text="Plan Several Game-Owned Content Types In Dependency Order. Generated Entries Still Require Individual Review, Approval, And Application In Content Review." TextWrapping="Wrap" Opacity="0.75"/>
                <TextBox Name="ContentExpansionRunNameText" PlaceholderText="Run Name"/>
                <TextBlock Text="Content Type"/>
                <ComboBox Name="ContentExpansionStageTypeList"/>
                <TextBlock Text="Designer Instruction"/>
                <TextBox Name="ContentExpansionStageInstructionText" PlaceholderText="Describe What This Stage Should Add" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <TextBlock Text="Quantity"/>
                <TextBox Name="ContentExpansionStageQuantityText" Text="1" PlaceholderText="1-20"/>
                <CheckBox Name="ContentExpansionDependsOnEarlierCheck" Content="Require All Earlier Stages First" IsChecked="True"/>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Name="AddContentExpansionStageButton" Content="Add Stage" Click="AddContentExpansionStage_Click"/>
                  <Button Name="ClearContentExpansionPlanButton" Content="Clear Plan" Click="ClearContentExpansionPlan_Click"/>
                </WrapPanel>
                <ListBox Name="PlannedContentExpansionStageList" MinHeight="110"/>
                <Button Name="SaveContentExpansionRunButton" Content="Save Expansion Run" Click="SaveContentExpansionRun_Click"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="1" Padding="16">
            <Grid RowDefinitions="Auto,Auto,180,Auto,*,Auto" RowSpacing="10">
              <TextBlock Text="Saved Expansion Runs" FontSize="20"/>
              <TextBlock Grid.Row="1" Text="WorldSeed Stops At Each Dependency Boundary Until Every Upstream Proposal Is Reviewed, Approved, And Applied." TextWrapping="Wrap" Opacity="0.75"/>
              <ListBox Grid.Row="2" Name="SavedContentExpansionRunList" SelectionChanged="SavedContentExpansionRunList_SelectionChanged"/>
              <WrapPanel Grid.Row="3" ItemSpacing="8" LineSpacing="8">
                <Button Name="GenerateNextExpansionStageButton" Content="Generate Next Ready Stage" Click="GenerateNextExpansionStage_Click" IsEnabled="False"/>
                <Button Name="RefreshContentExpansionRunsButton" Content="Refresh Runs" Click="RefreshContentExpansionRuns_Click"/>
              </WrapPanel>
              <TextBox Grid.Row="4" Name="ContentExpansionRunDetailText" Text="Select A Saved Expansion Run To Review Its Stages And Progress." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock Grid.Row="5" Name="ContentExpansionRunStatusText" Text="No Multi-Type Expansion Run Is Selected." TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Project Inventory">
        <Grid ColumnDefinitions="280,*,420" ColumnSpacing="16">
          <Border Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
              <TextBlock Text="Inventory History" FontSize="20"/>
              <TextBlock Grid.Row="1" Text="Each Inventory Is An Immutable Factual Snapshot. It Does Not Ask An AI What The Game Should Become." TextWrapping="Wrap" Opacity="0.75"/>
              <Button Grid.Row="2" Name="CreateProjectInventoryButton" Content="Build Current Inventory" Click="CreateProjectInventory_Click"/>
              <ListBox Grid.Row="3" Name="ProjectInventoryList" SelectionChanged="ProjectInventoryList_SelectionChanged"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" Padding="16">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
              <TextBlock Name="ProjectInventoryStatusText" Text="Load A Project To Build An Inventory." TextWrapping="Wrap"/>
              <TextBox Grid.Row="1" Name="ProjectInventorySummaryText" Text="Build An Inventory To Inspect The Current Rules, Schema, Content, Evaluation, And Publication Coverage." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
          </Border>
          <Border Grid.Column="2" Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*,Auto" RowSpacing="10">
              <TextBlock Text="Factual Observations" FontSize="20"/>
              <TextBlock Grid.Row="1" Text="Facts Are Grouped By Category To Keep Repeated Coverage Gaps Readable. AI Recommendations And Designer Decisions Will Be Added In The Development Plan Stage." TextWrapping="Wrap" Opacity="0.75"/>
              <ListBox Grid.Row="2" Name="ProjectInventoryObservationList"/>
              <TextBlock Grid.Row="3" Text="Review Coverage Gap"/>
              <ComboBox Grid.Row="4" Name="InventoryCoverageList" HorizontalAlignment="Stretch" SelectionChanged="InventoryCoverageList_SelectionChanged"/>
              <TextBox Grid.Row="5" Name="InventoryCoverageDetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <WrapPanel Grid.Row="6" ItemSpacing="8" LineSpacing="8"><Button Name="OpenInventoryEvidenceButton" Content="Open Evidence" Click="OpenInventoryEvidence_Click" IsEnabled="False"/><Button Name="DraftInventoryPassageButton" Content="Draft Selected Passage" Click="DraftInventoryPassage_Click" IsEnabled="False"/></WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Development Plan">
        <Grid ColumnDefinitions="300,*,420" ColumnSpacing="16">
          <Border Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
            <TextBlock Text="Plan Setup" FontSize="20"/>
            <TextBlock Text="Plans Use One Immutable Inventory Revision. They Recommend Work But Never Generate Or Apply Rules, Schema, Or Content." TextWrapping="Wrap" Opacity="0.75"/>
            <TextBlock Text="Designer Direction"/>
            <TextBox Name="DevelopmentPlanDirectionText" PlaceholderText="Optional Priorities, Boundaries, Or Preferred Direction" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Button Name="GenerateDevelopmentPlanButton" Content="Generate Development Plan" Click="GenerateDevelopmentPlan_Click"/>
            <Button Content="Start New Plan" Click="StartNewDevelopmentPlan_Click"/>
            <TextBlock Text="Plan History" FontSize="16" Margin="0,12,0,0"/>
            <ListBox Name="DevelopmentPlanList" MinHeight="220" SelectionChanged="DevelopmentPlanList_SelectionChanged"/>
          </StackPanel></ScrollViewer></Border>
          <Border Grid.Column="1" Padding="16"><Grid RowDefinitions="Auto,180,Auto,160,*" RowSpacing="10">
            <TextBlock Name="DevelopmentPlanStatusText" Text="Load A Project And Build An Inventory Before Generating A Development Plan." TextWrapping="Wrap"/>
            <TextBox Grid.Row="1" Name="DevelopmentPlanDetailText" Text="Select A Saved Plan Or Generate One From The Latest Project Inventory." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock Grid.Row="2" Text="Recommendations" FontSize="16"/>
            <ListBox Grid.Row="3" Name="DevelopmentRecommendationList" SelectionChanged="DevelopmentRecommendationList_SelectionChanged"/>
            <TextBox Grid.Row="4" Name="DevelopmentRecommendationDetailText" Text="Select A Recommendation To Review Its Evidence, Tradeoffs, Alternatives, And Any Difference Of Opinion." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          </Grid></Border>
          <Border Grid.Column="2" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
            <TextBlock Text="Designer Decisions" FontSize="20"/>
            <TextBlock Text="Guidance Is Required For Revision Requests. Decisions Are Preserved And Do Not Execute The Plan." TextWrapping="Wrap" Opacity="0.75"/>
            <TextBox Name="DevelopmentPlanGuidanceText" PlaceholderText="Decision Note Or Revision Guidance" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock Text="Whole Plan" FontSize="16"/>
            <WrapPanel ItemSpacing="6" LineSpacing="6"><Button Content="Approve Plan" Click="ApproveDevelopmentPlan_Click"/><Button Content="Reject Plan" Click="RejectDevelopmentPlan_Click"/><Button Content="Request Plan Revision" Click="ReviseDevelopmentPlan_Click"/></WrapPanel>
            <TextBlock Text="Selected Recommendation" FontSize="16" Margin="0,8,0,0"/>
            <WrapPanel ItemSpacing="6" LineSpacing="6"><Button Content="Accept" Click="AcceptDevelopmentRecommendation_Click"/><Button Content="Reject" Click="RejectDevelopmentRecommendation_Click"/><Button Content="Defer" Click="DeferDevelopmentRecommendation_Click"/><Button Content="Request Revision" Click="ReviseDevelopmentRecommendation_Click"/></WrapPanel>
            <Button Name="StartExpansionRequestButton" Content="Start Expansion Request" Click="StartExpansionRequest_Click" IsEnabled="False"/>
            <TextBlock Name="ExpansionRequestStatusText" Text="Accept A Recommendation To Start A Traceable Expansion Request." TextWrapping="Wrap" Opacity="0.75"/>
            <WrapPanel ItemSpacing="6" LineSpacing="6"><Button Name="SendExpansionToSchemaButton" Content="Send Rules To Schema" Click="SendExpansionToSchema_Click" IsEnabled="False"/><Button Name="MarkExpansionNoSchemaButton" Content="No Schema Change Required" Click="MarkExpansionNoSchema_Click" IsEnabled="False"/></WrapPanel>
            <TextBlock Text="A No-Schema Decision Requires A Rationale In The Guidance Box. Schema Work Remains A Proposal Until You Explicitly Activate It." TextWrapping="Wrap" Opacity="0.65"/>
            <TextBlock Text="Expansion Requests" FontSize="16" Margin="0,8,0,0"/>
            <ListBox Name="ExpansionRequestList" MinHeight="80" MaxHeight="150"/>
            <TextBlock Text="Decision History" FontSize="16" Margin="0,8,0,0"/>
            <TextBox Name="DevelopmentPlanDecisionHistoryText" Text="No Plan Is Selected." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
      <TabItem Header="Publication">
        <Grid ColumnDefinitions="300,360,*" ColumnSpacing="12">
          <Border Padding="16"><Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10"><TextBlock Text="Publication Snapshots" FontSize="20"/><TextBlock Grid.Row="1" Text="Builds Human-Readable Markdown Deterministically From The Selected Working Rule Snapshot, Active Schema, And Valid Canonical Game Data. Drafts And Unapplied Proposals Are Excluded." TextWrapping="Wrap" Opacity="0.75"/><Button Grid.Row="2" Name="CreatePublicationSnapshotButton" Content="Create Current Snapshot" Click="CreatePublicationSnapshot_Click"/><ListBox Grid.Row="3" Name="PublicationSnapshotList" SelectionChanged="PublicationSnapshotList_SelectionChanged"/><Button Grid.Row="4" Name="ExportPublicationMarkdownButton" Content="Export Snapshot Markdown" Click="ExportPublicationMarkdown_Click"/><Button Grid.Row="5" Name="ExportPublicationManifestButton" Content="Export Snapshot Manifest" Click="ExportPublicationManifest_Click"/></Grid></Border>
          <Border Grid.Column="1" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="8"><TextBlock Text="Edition Review" FontSize="20"/><TextBlock Text="Presentation Only: Titles And Section Arrangement Never Change Rules Or Game Data." TextWrapping="Wrap" Opacity="0.75"/><Button Name="CreatePublicationEditionButton" Content="Create Edition From Snapshot" Click="CreatePublicationEdition_Click"/><ListBox Name="PublicationEditionList" Height="110" SelectionChanged="PublicationEditionList_SelectionChanged"/><TextBlock Text="Edition Title"/><TextBox Name="PublicationEditionTitleText"/><TextBlock Text="Subtitle"/><TextBox Name="PublicationEditionSubtitleText"/><TextBlock Text="Top-Level Sections" FontSize="16"/><ListBox Name="PublicationSectionPlanList" Height="140"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Name="TogglePublicationSectionButton" Content="Include / Omit" Click="TogglePublicationSection_Click"/><Button Name="MovePublicationSectionUpButton" Content="Move Up" Click="MovePublicationSectionUp_Click"/><Button Name="MovePublicationSectionDownButton" Content="Move Down" Click="MovePublicationSectionDown_Click"/></StackPanel><TextBlock Text="Game Content Type Order" FontSize="16"/><ListBox Name="PublicationEntityPlanList" Height="120"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Name="MovePublicationEntityUpButton" Content="Move Up" Click="MovePublicationEntityUp_Click"/><Button Name="MovePublicationEntityDownButton" Content="Move Down" Click="MovePublicationEntityDown_Click"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="6"><Button Name="SavePublicationEditionButton" Content="Save Draft Revision" Click="SavePublicationEdition_Click"/><Button Name="ReadyPublicationEditionButton" Content="Mark Ready" Click="ReadyPublicationEdition_Click"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="6"><Button Name="ExportPublicationEditionMarkdownButton" Content="Export Ready Markdown" Click="ExportPublicationEditionMarkdown_Click"/><Button Name="ExportPublicationEditionManifestButton" Content="Export Edition Manifest" Click="ExportPublicationEditionManifest_Click"/></StackPanel><Expander Header="Section Editorial Review"><StackPanel Spacing="6" Margin="0,8,0,0"><TextBlock Name="PublicationEditorialStatusText" Text="Select A Snapshot To Begin Section Editing." TextWrapping="Wrap"/><TextBlock Text="Section"/><ComboBox Name="PublicationEditorialTargetList" SelectionChanged="PublicationEditorialTargetList_SelectionChanged"/><TextBlock Text="Source Material" FontSize="16"/><TextBlock Text="Compare Every Proposed Statement With These Immutable Sources. Local Models Can Add Unsupported Meaning." TextWrapping="Wrap" Opacity="0.75"/><TextBox Name="PublicationEditorialSourceText" Text="Select A Section To Inspect Its Exact Sources." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock Text="Designer Guidance"/><TextBox Name="PublicationEditorialGuidanceText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><Button Name="GeneratePublicationEditorialButton" Content="Generate Section Draft" Click="GeneratePublicationEditorial_Click"/><TextBlock Text="Draft History"/><ListBox Name="PublicationEditorialProposalList" Height="100" SelectionChanged="PublicationEditorialProposalList_SelectionChanged"/><TextBlock Text="Proposed Reader Text" FontSize="16"/><TextBox Name="PublicationEditorialText" Text="Select Or Generate A Section Draft." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><WrapPanel ItemSpacing="6" LineSpacing="6"><Button Name="ApprovePublicationEditorialButton" Content="Approve" Click="ApprovePublicationEditorial_Click"/><Button Name="RejectPublicationEditorialButton" Content="Reject" Click="RejectPublicationEditorial_Click"/><Button Name="RevisePublicationEditorialButton" Content="Request Revision" Click="RevisePublicationEditorial_Click"/></WrapPanel><TextBox Name="PublicationEditorialDecisionText" Text="No Designer Decision Recorded." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/></StackPanel></Expander></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="2" Padding="16"><Grid RowDefinitions="Auto,*,Auto,200" RowSpacing="10"><TextBlock Name="PublicationStatusText" Text="Load A Project To Build Or Review Publication Snapshots." TextWrapping="Wrap"/><TextBox Grid.Row="1" Name="PublicationMarkdownText" Text="No Publication Snapshot Or Edition Is Selected." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock Grid.Row="2" Text="Provenance Manifest" FontSize="16"/><TextBox Grid.Row="3" Name="PublicationManifestText" Text="No Manifest Is Selected." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid></Border>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="Local-Only: Originals Are Preserved; Drafts Remain Non-Canonical." Opacity="0.6"/>
  </Grid>
</Window>
