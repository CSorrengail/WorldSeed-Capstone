<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.NewProjectWindow" Title="New WorldSeed Project" Width="480" Height="310" MinWidth="420" MinHeight="280" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="10">
    <TextBlock Text="Create Project" FontSize="24"/>
    <TextBox Grid.Row="1" Name="NameInput" PlaceholderText="Project Name"/>
    <TextBox Grid.Row="2" Name="DescriptionInput" PlaceholderText="Optional Description Or Design Goal" AcceptsReturn="True" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Choose Save Location" Click="Create_Click"/></StackPanel>
  </Grid>
</Window>
