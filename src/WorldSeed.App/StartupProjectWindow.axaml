<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorldSeed.App.StartupProjectWindow" Title="Open WorldSeed Project" Width="500" Height="360" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="12">
    <StackPanel><TextBlock Text="Choose a project" FontSize="24"/><TextBlock Name="HintText" Text="Select a saved project or create a new one." Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
    <ListBox Grid.Row="1" Name="ProjectList"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Create new" Click="Create_Click"/><Button Name="OpenButton" Content="Open selected" Click="Open_Click"/></StackPanel>
  </Grid>
</Window>
