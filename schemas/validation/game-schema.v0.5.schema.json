{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ttrpg/game-schema.v0.5.schema.json",
  "title": "TTRPG Game Schema v0.5",
  "type": "object",
  "required": ["id", "name", "version", "entityTypes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "schemaFragments": { "type": "array", "items": { "$ref": "#/$defs/owner" } },
    "entityTypes": { "type": "array", "items": { "$ref": "#/$defs/owner" } },
    "valueTypes": { "type": "array", "items": { "$ref": "#/$defs/owner" } },
    "relationships": { "type": "array" },
    "rules": { "type": "array" },
    "procedures": { "type": "array" },
    "validations": { "type": "array" }
  },
  "$defs": {
    "metadata": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } } },
    "owner": { "type": "object", "required": ["metadata"], "properties": { "metadata": { "$ref": "#/$defs/metadata" }, "fragmentIds": { "type": "array", "items": { "type": "string" } }, "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } } } },
    "property": { "type": "object", "required": ["metadata", "valueType", "required", "nullable"], "properties": { "metadata": { "$ref": "#/$defs/metadata" }, "valueType": { "$ref": "#/$defs/typeExpression" }, "required": { "type": "boolean" }, "nullable": { "type": "boolean" }, "constraints": { "$ref": "#/$defs/constraints" } } },
    "constraints": { "type": "object", "properties": { "minimum": { "type": "number" }, "maximum": { "type": "number" }, "minimumLength": { "type": "integer", "minimum": 0 }, "maximumLength": { "type": "integer", "minimum": 0 }, "pattern": { "type": "string" }, "distinctItems": { "type": "boolean" } } },
    "typeExpression": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["primitive", "definedValueType", "reference", "collection", "map", "union"] } }, "allOf": [
      { "if": { "properties": { "kind": { "const": "primitive" } } }, "then": { "required": ["name"], "properties": { "name": { "enum": ["string", "integer", "decimal", "boolean", "date", "dateTime", "any"] } } } },
      { "if": { "properties": { "kind": { "const": "definedValueType" } } }, "then": { "required": ["valueTypeId"], "properties": { "valueTypeId": { "type": "string", "minLength": 1 } } } },
      { "if": { "properties": { "kind": { "const": "reference" } } }, "then": { "required": ["allowedEntityTypeIds"], "properties": { "allowedEntityTypeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } },
      { "if": { "properties": { "kind": { "const": "collection" } } }, "then": { "required": ["itemType"], "properties": { "itemType": { "$ref": "#/$defs/typeExpression" }, "minimumItems": { "type": "integer", "minimum": 0 }, "maximumItems": { "type": "integer", "minimum": 0 }, "ordered": { "type": "boolean" } } } },
      { "if": { "properties": { "kind": { "const": "map" } } }, "then": { "required": ["keyType", "valueType"], "properties": { "keyType": { "$ref": "#/$defs/typeExpression" }, "valueType": { "$ref": "#/$defs/typeExpression" } } } },
      { "if": { "properties": { "kind": { "const": "union" } } }, "then": { "required": ["options"], "properties": { "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/typeExpression" } } } } }
    ] }
  }
}
