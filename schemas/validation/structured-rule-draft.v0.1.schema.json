{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldseed.invalid/structured-rule-draft.v0.1.schema.json",
  "title": "WorldSeed Structured Rule Draft v0.1",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": { "enum": ["askClarifyingQuestion", "presentDraft"] },
    "clarifyingQuestion": { "type": "string", "minLength": 1 },
    "draft": { "$ref": "#/$defs/draft" }
  },
  "allOf": [
    { "if": { "properties": { "action": { "const": "askClarifyingQuestion" } } }, "then": { "required": ["clarifyingQuestion"] } },
    { "if": { "properties": { "action": { "const": "presentDraft" } } }, "then": { "required": ["draft"] } }
  ],
  "$defs": {
    "draft": { "type": "object", "required": ["title", "intent", "rules", "concepts", "assumptions", "openQuestions", "exclusions"], "properties": {
      "title": { "type": "string", "minLength": 1 }, "intent": { "type": "string", "minLength": 1 },
      "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
      "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
      "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "openQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    } },
    "rule": { "type": "object", "required": ["id", "name", "kind", "text", "sourceNoteIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "kind": { "enum": ["definition", "rule", "procedure", "constraint"] }, "text": { "type": "string", "minLength": 1 }, "sourceNoteIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "concept": { "type": "object", "required": ["id", "name", "description"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } }
  }
}
